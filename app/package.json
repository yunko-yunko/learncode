{
  "name": "learncode",
  "productName": "learncode",
  "version": "1.0.1",
  "description": "Windows 코드 학습 앱",
  "main": "src/main.cjs",
  "author": "learncode",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "npm run build && electron .",
    "test": "node --test tests/core.test.cjs",
    "test:e2e": "npm run build && node tests/e2e.mjs",
    "setup:python": "node scripts/setup-python.cjs",
    "pack:win": "npm run build && electron-builder --win --dir",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.learncode.desktop",
    "productName": "learncode",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/main.cjs",
      "src/preload.cjs",
      "src/core/**",
      "dist/renderer/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resource",
        "to": "resource",
        "filter": [
          "**/*.json"
        ]
      },
      {
        "from": "requirements.txt",
        "to": "requirements.txt"
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false,
      "artifactName": "learncode-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "learncode"
    }
  },
  "dependencies": {
    "@codemirror/commands": "6.11.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.44.1",
    "adm-zip": "0.6.1",
    "dompurify": "3.5.0",
    "highlight.js": "11.12.0",
    "lucide": "1.81.0",
    "marked": "18.3.0"
  },
  "overrides": {
    "minimatch@>=7 <11.0.1": "^11.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "electron": "45.5.0",
    "electron-builder": "26.18.0",
    "vite": "8.4.0"
  }
}
